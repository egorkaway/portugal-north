{
  "expo": {
    "name": "VeryStays",
    "slug": "verystays",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verystays",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "buildNumber": "76",
      "bundleIdentifier": "com.iberian.travel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "UIRequiresFullScreen": true,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "pt",
          "es",
          "gl",
          "ca",
          "uk",
          "ru"
        ],
        "NSLocationWhenInUseUsageDescription": "VeryStays uses your location to sort stations by distance, power the nearest-station widget, and watch for arrivals at busy hubs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "VeryStays uses your location in the background to notify you when you arrive at major train stations — even when the app is closed.",
        "NSLocationAlwaysUsageDescription": "VeryStays uses your location in the background to notify you when you arrive at major train stations — even when the app is closed.",
        "NSUserTrackingUsageDescription": "VeryStays uses this identifier to measure how people find the app and to attribute in-app purchases.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "pt": "./locales/pt.json",
      "es": "./locales/es.json",
      "gl": "./locales/gl.json",
      "ca": "./locales/ca.json",
      "uk": "./locales/uk.json",
      "ru": "./locales/ru.json"
    },
    "android": {
      "package": "com.iberian.travel",
      "adaptiveIcon": {
        "backgroundColor": "#012841",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 76,
      "permissions": [
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#012841"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VeryStays uses your location to sort stations by distance, power the nearest-station widget, and watch for arrivals at busy hubs.",
          "locationAlwaysAndWhenInUsePermission": "VeryStays uses your location in the background to notify you when you arrive at major train stations — even when the app is closed.",
          "locationAlwaysPermission": "VeryStays uses your location in the background to notify you when you arrive at major train stations — even when the app is closed.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-notifications",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "VeryStays uses this identifier to measure how people find the app and to attribute in-app purchases."
        }
      ],
      "expo-task-manager",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.iberian.travel.widgets",
          "groupIdentifier": "group.com.iberian.travel",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "TripWidget",
              "displayName": "Train countdown",
              "description": "Countdown to your next train, last trip taken, or nearest station.",
              "ios": {
                "contentMarginsDisabled": true,
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "./plugins/withWidgetContainerBackground.js",
      "./plugins/withAndroidUploadSigning.js",
      "./plugins/withAndroidReleaseArtifactNames.js",
      "./plugins/withAndroidUserAgent.js",
      "./plugins/withAndroidPlayBilling.js",
      "expo-sharing",
      "expo-core-spotlight",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "pt",
              "es",
              "gl",
              "ca",
              "uk",
              "ru"
            ],
            "android": [
              "en",
              "pt",
              "es",
              "gl",
              "ca",
              "uk",
              "ru"
            ]
          }
        }
      ],
      "./plugins/withKnownRegions.js",
      "./plugins/withAppIntents.js",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
